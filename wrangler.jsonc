{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "war-thunder-workbench",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wt.mrtreasure.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
