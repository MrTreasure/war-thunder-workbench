{
  "name": "war-thunder-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && vite --host 0.0.0.0 --port 5178 --strictPort",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint src vite.config.ts --deny-warnings",
    "build": "node scripts/prepare-data.mjs && node scripts/check-data.mjs && tsr generate && tsc --noEmit && node scripts/build-player-stats-preview.mjs && vite build && node scripts/build-seo.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4178",
    "refresh": "node scripts/refresh.mjs",
    "publish": "python3 scripts/publish.py",
    "release": "pnpm run build && pnpm run publish",
    "check:data": "node scripts/prepare-data.mjs && node scripts/check-data.mjs",
    "format": "oxfmt src scripts/*.mjs vite.config.ts",
    "format:check": "oxfmt --check src scripts/*.mjs vite.config.ts",
    "refresh:branding": "python3 scripts/branding.py",
    "refresh:localization": "python3 scripts/localization.py",
    "refresh:lineup-codes": "node scripts/lineup-codebook.mjs",
    "refresh:prices": "node scripts/store-prices.mjs",
    "refresh:guides": "node scripts/extract-map-atlas.mjs",
    "refresh:collections": "node scripts/extract-map-collections.mjs",
    "check": "tsr generate && pnpm run typecheck && pnpm run lint && pnpm run check:data && pnpm run check:map-editor",
    "import:qmuse": "pnpm run check && pnpm run build && qmuse-cli import . --no-open",
    "check:map-editor": "node --experimental-strip-types scripts/check-map-editor.mjs",
    "build:stats-preview": "node scripts/build-player-stats-preview.mjs",
    "refresh:leaderboards": "node scripts/refresh-player-leaderboards.mjs",
    "research:valuation-policies": "node scripts/research-valuation-policies.mjs",
    "prepare:valuation": "node scripts/prepare-data.mjs && node scripts/prepare-account-valuation.mjs",
    "prepare:ownership": "node scripts/prepare-data.mjs && node scripts/prepare-player-research-counts.mjs",
    "deploy:qmuse": "node scripts/deploy-qmuse.mjs",
    "deploy:cf": "node scripts/deploy-cf.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.101.1",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.3.4"
  },
  "devDependencies": {
    "@qmuse/qmuse-cli": "1.0.7",
    "@qmuse/vite-config": "1.0.13",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "22.16.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "linkedom": "0.18.13",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.0.2",
    "wrangler": "4.151.3"
  },
  "license": "MIT"
}
