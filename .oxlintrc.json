{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "controlComponents": ["GameSelect"] }
    ]
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "src/generated/**",
    "src/routeTree.gen.ts"
  ]
}
