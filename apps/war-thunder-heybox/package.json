{
  "name": "war-thunder-heybox",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "heybox": {
    "miniProgramId": "01a16e09-097b-7867-a702-7537cd3919fd",
    "name": "战雷工作台",
    "category": "tool",
    "icon": "assets/workbench-icon.png",
    "coverImages": [
      "assets/workbench-cover.jpg"
    ],
    "platforms": [
      "android",
      "ios"
    ],
    "permissions": {
      "userInfo": {
        "enabled": true
      },
      "network": {
        "enabled": true
      },
      "storage": {
        "enabled": true
      },
      "clipboard": {
        "enabled": true
      },
      "share": {
        "enabled": true
      }
    },
    "desc": "面向战争雷霆玩家，提供载具与配件研发、战绩查询、参考估值、载具成就与战报分享。"
  },
  "scripts": {
    "hb-sdk": "hb-sdk",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && hb-sdk build && node scripts/check-build.mjs",
    "deploy": "hb-sdk remote deploy",
    "typecheck": "tsc --noEmit",
    "prepare:branding": "node scripts/prepare-branding.mjs",
    "test": "node --test tests/*.test.mts"
  },
  "dependencies": {
    "@heybox/hb-sdk": "0.9.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@12.3.4"
}
